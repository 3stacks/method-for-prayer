{
  "name": "method-for-prayer",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "description": "Pray in the words of Scripture with Matthew Henry's A Method for Prayer (1710). One Expo app for the web, iOS and Android.",
  "license": "UNLICENSED",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 5190",
    "build": "tsc --noEmit && expo export --platform web && node scripts/seo.mjs && node scripts/web-postbuild.mjs",
    "site": "npm run build && npm --prefix site run build && node scripts/merge-site.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs src/lib/*.test.ts functions/_lib/*.test.ts",
    "data": "node scripts/build-kjv.mjs && node scripts/build-data.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/source-serif-4": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
