# Cloudflare Pages. Hashed files never change. The app shell must revalidate,
# so that an update reaches every visitor.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/book/*
  Cache-Control: no-cache

/head/*
  Cache-Control: no-cache
